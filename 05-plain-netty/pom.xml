<?xml version="1.0" encoding="UTF-8"?>
<!--
  App 05: plain Netty, no Reactor and no Spring on the classpath at all.

  Purpose: app 01 (Reactor Netty) is still Netty underneath. The difference
  between 01 and 05 is *exactly* the Reactor layer - Mono allocation, the
  reactive channel pipeline, operator bookkeeping - and nothing else.

  Netty version pinned to the same 4.1.135.Final that reactor-netty 1.2.18
  resolves, so the comparison is not contaminated by a different Netty.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>bench</groupId>
  <artifactId>05-plain-netty</artifactId>
  <version>1.0</version>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <netty.version>4.1.135.Final</netty.version>
    <slf4j.version>2.0.18</slf4j.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-codec-http</artifactId>
      <version>${netty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
  </dependencies>
</project>
